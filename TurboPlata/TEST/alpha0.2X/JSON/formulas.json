{
  "__пример": "Формулы расчёта оплаты и конфигурация MQTT. Заполняется админом через веб-интерфейс /admin.",
  "__демо_разряды": { "1": 1.0, "2": 1.2, "3": 1.5 },
  "__демо_mqtt":   { "брокер": "localhost:1883", "топик_подписки": "factory/table/+/scan" },
  "__формула":     "оплата_коп = базовая_ставка_коп × норма_сек_1шт × количество_коробки × коэфф_разряда. В БД копейки, в интерфейсе рубли (/100).",

  "глобальные_константы": {
    "оплата_в_секунду_базовая_коп": 50,
    "оплата_брака_процент": 100,
    "коэффициенты_разрядов": {
      "1": 1.0,
      "2": 1.2,
      "3": 1.5
    },
    "уровень_доверия_процент": 20
  },
  "формула_начисления": {
    "выражение": "база * коэфф_разряда * мин(1.0, время_норм / время_факт) * (1 - штраф * 0.5)",
    "переменные": {
      "база": "операция.базовая_ставка",
      "коэфф_разряда": "операция.коэффициент_разряда",
      "время_норм": "операция.норма_времени",
      "время_факт": "выработка.время_окончания - выработка.время_начала",
      "штраф": "выработка.штраф"
    }
  },
  "проверка_реальности": {
    "минимальное_время_на_изделие_сек": 10,
    "реакция": "флаг_подозрения"
  },
  "mqtt": {
    "брокер": "localhost:1883",
    "топик_подписки": "factory/table/+/scan",
    "qos": 1,
    "username": "",
    "password": ""
  },
  "экспорт": {
    "время_экспорта": "20:00",
    "путь_экспорта": "./exports/",
    "формат": "xml",
    "сохранять_дней": 30
  },
  "печать": {
    "формат_листа": "A4 landscape",
    "поля_мм": "8",
    "колонок": "3",
    "записей_на_колонку": "6",
    "размер_шрифта_баркода": "22",
    "размер_шрифта_текста": "10",
    "размер_шрифта_шапки": "11",
    "шрифт_баркода": "BARCODE.ttf",
    "шрифт_обычный": "Segoe UI, Arial",
    "префикс_заказа": "zkz",
    "префикс_коробки": "bx",
    "префикс_брак": "br",
    "префикс_операции": "op",
    "разделитель1": "X",
    "разделитель2": "Z"
  }
}
