{
  "__пример": "Схема БД — сервер сам создаёт таблицы при первом запуске. Три файла: turboplata.db (заказы/коробки/журнал), employees.db (сотрудники), workplaces.db (рабочие места).",
  "__демо_заказ":          { "название": "Платье летнее", "количество_план": 100 },
  "__демо_техкарта":       { "ид_заказа": 1, "шаг": 1, "название_операции": "Стачивание боковых швов", "норма_времени_сек": 120, "разряд": 2 },
  "__демо_коробка":        { "ид_заказа": 1, "количество": 25, "статус": "в_работе" },
  "__демо_операция":       { "ид_коробки": 1, "шаг": 1, "название": "Стачивание боковых швов", "норма_времени_сек": 120, "статус": "ожидает" },
  "__демо_журнал":         { "ид_операции": 1, "ид_рабочего": 100, "ид_стола": "esp32-table-1", "сумма_начислена": 50.0 },
  "__демо_сотрудник":      { "фио": "Иванова М.И.", "табельный_номер": "USER_100", "права": "worker" },
  "__демо_рабочее_место":  { "esp_hostname": "esp32-otk-1", "pc_hostname": "COMP-OTK-1", "роль_места": "otk" },

  "базы_данных": {
    "основная": {
      "файл": "turboplata.db",
      "описание": "Заказы, техкарты, коробки, операции, журнал выработки",
      "таблицы": {
        "заказы": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "название", "тип": "TEXT NOT NULL" },
            { "имя": "код", "тип": "TEXT" },
            { "имя": "количество_план", "тип": "INTEGER NOT NULL" },
            { "имя": "активный", "тип": "INTEGER DEFAULT 1" },
            { "имя": "дата_создания", "тип": "DATETIME DEFAULT CURRENT_TIMESTAMP" }
          ]
        },
        "техкарты": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "ид_заказа", "тип": "INTEGER NOT NULL" },
            { "имя": "шаг", "тип": "INTEGER NOT NULL" },
            { "имя": "код", "тип": "TEXT" },
            { "имя": "название_операции", "тип": "TEXT NOT NULL" },
            { "имя": "норма_времени_сек", "тип": "REAL NOT NULL" },
            { "имя": "разряд", "тип": "INTEGER DEFAULT 1" },
            { "имя": "активный", "тип": "INTEGER DEFAULT 1" }
          ]
        },
        "коробки": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "ид_заказа", "тип": "INTEGER NOT NULL" },
            { "имя": "код", "тип": "TEXT" },
            { "имя": "номер_в_заказе", "тип": "INTEGER NOT NULL DEFAULT 1" },
            { "имя": "количество", "тип": "INTEGER NOT NULL" },
            { "имя": "статус", "тип": "TEXT DEFAULT 'в_работе'" },
            { "имя": "дата_создания", "тип": "DATETIME DEFAULT CURRENT_TIMESTAMP" },
            { "имя": "дата_завершения", "тип": "DATETIME" }
          ]
        },
        "операции_коробки": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "ид_коробки", "тип": "INTEGER NOT NULL" },
            { "имя": "ид_техкарты", "тип": "INTEGER NOT NULL" },
            { "имя": "шаг", "тип": "INTEGER NOT NULL" },
            { "имя": "название", "тип": "TEXT NOT NULL" },
            { "имя": "код", "тип": "TEXT" },
            { "имя": "норма_времени_сек", "тип": "REAL NOT NULL" },
            { "имя": "разряд", "тип": "INTEGER DEFAULT 1" },
            { "имя": "статус", "тип": "TEXT DEFAULT 'ожидает'" },
            { "имя": "ид_исполнителя", "тип": "INTEGER" },
            { "имя": "брак", "тип": "INTEGER DEFAULT 0" }
          ]
        },
        "журнал_выработки": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "ид_операции", "тип": "INTEGER NOT NULL" },
            { "имя": "ид_рабочего", "тип": "INTEGER NOT NULL" },
            { "имя": "ид_стола", "тип": "TEXT NOT NULL" },
            { "имя": "время_начала", "тип": "DATETIME NOT NULL" },
            { "имя": "время_окончания", "тип": "DATETIME" },
            { "имя": "сумма_начислена", "тип": "REAL" },
            { "имя": "штраф", "тип": "INTEGER DEFAULT 0" },
            { "имя": "статус_выплаты", "тип": "TEXT DEFAULT 'начислено'" }
          ]
        },
        "аудит": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "тип", "тип": "TEXT NOT NULL" },
            { "имя": "ид_выработки", "тип": "INTEGER" },
            { "имя": "ид_рабочего", "тип": "INTEGER" },
            { "имя": "сумма", "тип": "REAL" },
            { "имя": "данные", "тип": "TEXT" },
            { "имя": "создано", "тип": "DATETIME DEFAULT CURRENT_TIMESTAMP" }
          ]
        }
      }
    },
    "сотрудники": {
      "файл": "employees.db",
      "описание": "Сотрудники, права доступа",
      "таблицы": {
        "сотрудники": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "фио", "тип": "TEXT NOT NULL" },
            { "имя": "табельный_номер", "тип": "TEXT UNIQUE NOT NULL" },
            { "имя": "права", "тип": "TEXT DEFAULT 'worker'" },
            { "имя": "разряд", "тип": "INTEGER DEFAULT 1" },
            { "имя": "активный", "тип": "INTEGER DEFAULT 1" },
            { "имя": "пароль", "тип": "TEXT DEFAULT ''" }
          ]
        }
      }
    },
    "рабочие_места": {
      "файл": "workplaces.db",
      "описание": "Привязка ESP32 к ПК, роли рабочих мест",
      "таблицы": {
        "рабочие_места": {
          "столбцы": [
            { "имя": "ид", "тип": "INTEGER PRIMARY KEY AUTOINCREMENT" },
            { "имя": "esp_hostname", "тип": "TEXT UNIQUE NOT NULL" },
            { "имя": "pc_hostname", "тип": "TEXT" },
            { "имя": "роль_места", "тип": "TEXT DEFAULT 'станок'" },
            { "имя": "описание", "тип": "TEXT" },
            { "имя": "активное", "тип": "INTEGER DEFAULT 1" }
          ]
        }
      }
    }
  }
}
